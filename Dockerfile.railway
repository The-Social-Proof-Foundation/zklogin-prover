# Trixie ships libstdc++ with GLIBCXX_3.4.32. node:18-slim is Bookworm and
# stops at GLIBCXX_3.4.30, so rapidsnark 0.0.8 refuses to start.
FROM node:22-trixie-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    libstdc++6 \
    libsodium23 \
    libgomp1 \
    unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json yarn.lock ./
RUN yarn install --production --frozen-lockfile

COPY server.js zklogin-inputs.js verify-prover-artifacts.js groth16-prove.js entrypoint.sh ./
RUN chmod +x /app/entrypoint.sh

# Optional CLI binary kept for local debugging only. Production prove uses
# volume-mounted proverServer started by entrypoint.sh (hot zkey in RAM).
RUN curl -fsSL -o /tmp/rapidsnark.zip \
      https://github.com/iden3/rapidsnark/releases/download/v0.0.8/rapidsnark-linux-x86_64-v0.0.8.zip \
    && unzip -j /tmp/rapidsnark.zip '*/bin/prover' -d /usr/local/bin \
    && mv /usr/local/bin/prover /usr/local/bin/rapidsnark \
    && chmod +x /usr/local/bin/rapidsnark \
    && rm -f /tmp/rapidsnark.zip

ENV RAPIDSNARK_BIN=/usr/local/bin/rapidsnark
ENV PROVE_ENGINE=proverServer
ENV RAPIDSNARK_SERVER_URL=http://127.0.0.1:8080
ENV OMP_NUM_THREADS=8

EXPOSE 4000
CMD ["./entrypoint.sh"]
