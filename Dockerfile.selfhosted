FROM mysten/zklogin:prover-fe-stable@sha256:4eb3a8276d455e22427145c5d6b70313468b5ec187389dea005b987051a5e0a7 AS fe
FROM mysten/zklogin:prover-stable@sha256:f699a667d12400ba5c975eac623efd5095e07af25d8252db0fe71b1752e6e609

RUN apt-get update && apt-get install -y --no-install-recommends b2sum ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=fe / /opt/prover-fe-root
RUN mkdir -p /opt/prover-fe \
  && if [ -f /opt/prover-fe-root/app/package.json ]; then cp -a /opt/prover-fe-root/app/. /opt/prover-fe/; \
     elif [ -f /opt/prover-fe-root/package.json ]; then cp -a /opt/prover-fe-root/. /opt/prover-fe/; \
     else cp -a /opt/prover-fe-root/. /opt/prover-fe/; fi \
  && if [ -x /opt/prover-fe-root/usr/local/bin/node ]; then cp /opt/prover-fe-root/usr/local/bin/node /usr/local/bin/node; fi

COPY server.js /opt/router/server.js
COPY scripts/run-self-hosted.sh /run-self-hosted.sh
RUN chmod +x /run-self-hosted.sh

ENV PORT=4000
EXPOSE 4000
ENTRYPOINT ["/run-self-hosted.sh"]
